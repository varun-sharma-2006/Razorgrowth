# RazorGrowth Environment Configuration

# Database: Uses SQLite async by default for zero-setup local dev. Set postgresql+asyncpg://... for PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./razorgrowth.db

# Razorpay Test Mode Credentials (leave blank to run in LOCAL DEMO MODE)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=razorgrowth_wh_secret_123

# AI Provider Credentials (leave blank to run in AI Provider: Demo Heuristic Mode)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Application Settings
MERCHANT_ID=merch_razorgrowth_01
MAX_SINGLE_ACTION_BUDGET=1000.00
ALLOWED_ACTION_TYPES=failed_payment_recovery,checkout_recovery
