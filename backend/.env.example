# RazorGrowth Environment Configuration
# Copy to .env. Blank values keep the zero-credential demo modes.

# Database: SQLite for local dev. For PostgreSQL use postgresql://user:pass@host/db (asyncpg is used automatically)
DATABASE_URL=sqlite+aiosqlite:///./razorgrowth.db
# Apply Alembic migrations on startup
AUTO_MIGRATE=true

# Security
# Required for any shared/deployed instance: every admin endpoint then needs the X-Admin-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Razorpay Test Mode credentials (leave blank for LOCAL DEMO MODE)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the secret configured in the Razorpay dashboard. Webhooks are rejected while blank.
RAZORPAY_WEBHOOK_SECRET=

# AI provider (leave both blank for Demo Heuristic Mode; Gemini wins if both are set)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Merchant policy defaults
MERCHANT_ID=merch_razorgrowth_01
DEFAULT_MAX_BUDGET=1000.00
ALLOWED_ACTION_TYPES=failed_payment_recovery,checkout_recovery
RECOVERY_CONVERSION_RATE=0.70
